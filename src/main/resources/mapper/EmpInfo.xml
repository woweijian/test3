<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dongbao.test_demo3.mapper.EmpInfoMapper">

    <!-- 查询所有员工信息 -->
    <select id="findAll" resultType="com.dongbao.test_demo3.entity.EmpInfo">
        SELECT * FROM EmpInfo
    </select>

    <!-- 根据ID查询员工信息 -->
    <select id="findById" parameterType="int" resultType="com.dongbao.test_demo3.entity.EmpInfo">
        SELECT * FROM EmpInfo WHERE id = #{id}
    </select>


    <!-- 插入员工信息 -->
    <insert id="insert" parameterType="com.dongbao.test_demo3.entity.EmpInfo">
        INSERT INTO EmpInfo (name, age, department)
        VALUES (#{name}, #{age}, #{department})
    </insert>

    <!-- 更新员工信息 -->
    <update id="update" parameterType="com.dongbao.test_demo3.entity.EmpInfo">
        UPDATE EmpInfo
        WHERE id = #{id}
    </update>

    <!-- 删除员工信息 -->
    <delete id="delete" parameterType="int">
        DELETE FROM EmpInfo WHERE id = #{id}
    </delete>

</mapper>